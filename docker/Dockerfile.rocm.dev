# A development server for AMD GPUs. Match ROCM_VERSION to the host driver and
# TORCH_INDEX_URL to a PyTorch ROCm wheel index for that release, e.g.
#   docker build -f docker/Dockerfile.rocm.dev \
#     --build-arg ROCM_VERSION=7.0 \
#     --build-arg TORCH_INDEX_URL=https://download.pytorch.org/whl/rocm7.0 .
ARG ROCM_VERSION=7.0

FROM ghcr.io/astral-sh/uv:0.11.30 AS uv

FROM rocm/dev-ubuntu-22.04:${ROCM_VERSION}

ARG TORCH_INDEX_URL=https://download.pytorch.org/whl/rocm7.0
# ROCR-Runtime release to rebuild with the libhsakmt patch; empty means the
# image's own ROCm release (/opt/rocm/.info/version).
ARG ROCR_TAG=

ENV DEBIAN_FRONTEND=noninteractive \
    CXX=g++ \
    PATH="/opt/venv/bin:$PATH" \
    PYTHONUNBUFFERED=1 \
    UV_LINK_MODE=copy \
    UV_NO_CACHE=1 \
    UV_PYTHON_DOWNLOADS=0 \
    VIRTUAL_ENV=/opt/venv \
    KCORAL_GPU_BACKEND=rocm

# libdrm looks for amdgpu.ids under /opt/amdgpu; the link silences its warning in
# the unsandboxed server only (the sandbox does not expose /opt/amdgpu yet).
RUN apt-get update \
    && apt-get install --no-install-recommends -y \
        ca-certificates \
        cmake \
        curl \
        g++ \
        git \
        libcap-dev \
        libdrm-dev \
        libelf-dev \
        libnuma-dev \
        meson \
        pkg-config \
        python3 \
        python3-venv \
        rocm-llvm-dev \
        xxd \
        xz-utils \
    && rm -rf /var/lib/apt/lists/* \
    && mkdir -p /opt/amdgpu/share \
    && ln -s /usr/share/libdrm /opt/amdgpu/share/libdrm

# KCoral's sandbox needs bubblewrap >= 0.8 (--disable-userns); Ubuntu 22.04 ships 0.6.1.
RUN curl -fsSL -o /tmp/bubblewrap.tar.xz \
        https://github.com/containers/bubblewrap/releases/download/v0.11.0/bubblewrap-0.11.0.tar.xz \
    && echo '988fd6b232dafa04b8b8198723efeaccdb3c6aa9c1c7936219d5791a8b7a8646  /tmp/bubblewrap.tar.xz' \
        | sha256sum -c - \
    && mkdir /tmp/bubblewrap \
    && tar -xJf /tmp/bubblewrap.tar.xz -C /tmp/bubblewrap --strip-components=1 \
    && meson setup /tmp/bubblewrap/build /tmp/bubblewrap --prefix=/usr/local -Dman=disabled \
    && meson compile -C /tmp/bubblewrap/build \
    && meson install -C /tmp/bubblewrap/build \
    && rm -rf /tmp/bubblewrap /tmp/bubblewrap.tar.xz \
    && bwrap --help | grep -q -- --disable-userns

COPY --from=uv /uv /uvx /bin/

WORKDIR /workspace/kcoral

# torch from the ROCm index brings its matching pytorch-triton-rocm.
RUN uv venv /opt/venv \
    && uv pip install --index-url "$TORCH_INDEX_URL" torch

COPY docker/requirements.rocm.txt /tmp/requirements.rocm.txt
RUN uv pip install -r /tmp/requirements.rocm.txt

# Through ROCm 7.0.2, libhsakmt fails when a sandboxed worker sees only its own
# render node. Rebuild the HSA runtime (libhsakmt is linked into it) with the
# fix, and replace both the /opt/rocm copy and the one bundled with torch.
COPY docker/rocm-libhsakmt-patch/0001-libhsakmt-skip-memory-policy-for-unusable-gpus.patch /tmp/rocr.patch
COPY docker/rocm-libhsakmt-patch/install_patched_rocr.sh /tmp/install_patched_rocr.sh
RUN tag="${ROCR_TAG:-rocm-$(cut -d- -f1 /opt/rocm/.info/version)}" \
    && git clone --depth 1 --branch "$tag" https://github.com/ROCm/ROCR-Runtime.git /tmp/rocr \
    && git -C /tmp/rocr apply /tmp/rocr.patch \
    && grep -q "skip GPUs the kernel" /tmp/rocr/libhsakmt/src/fmm.c \
    && cmake -S /tmp/rocr -B /tmp/rocr/build -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_PREFIX_PATH=/opt/rocm -DCMAKE_INSTALL_PREFIX=/tmp/rocr/install \
        -DBUILD_SHARED_LIBS=ON \
    && cmake --build /tmp/rocr/build -j"$(nproc)" \
    && cmake --install /tmp/rocr/build \
    && bash /tmp/install_patched_rocr.sh /tmp/rocr/install \
    && rm -rf /tmp/rocr /tmp/rocr.patch /tmp/install_patched_rocr.sh

# --no-deps: the `server` extra would replace the ROCm torch with a CUDA build.
COPY pyproject.toml setup.py MANIFEST.in README.md ./
COPY python ./python
RUN SETUPTOOLS_SCM_PRETEND_VERSION=0.0.0+rocm.dev uv pip install --no-deps -e .

ENV KCORAL_SERVER_HOST=0.0.0.0

EXPOSE 8000

# Workers run in bubblewrap (the default); the container needs the options in
# docker/compose.yaml's kcoral-rocm service.
CMD ["python", "-m", "kcoral", "server", "--backend", "rocm"]
