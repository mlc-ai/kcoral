# syntax=docker/dockerfile:1

# A development server for AMD GPUs. Match ROCM_VERSION to the host driver and
# TORCH_INDEX_URL to a PyTorch ROCm wheel index for that release, e.g.
#   docker build -f docker/Dockerfile.rocm.dev \
#     --build-arg ROCM_VERSION=7.0 \
#     --build-arg TORCH_INDEX_URL=https://download.pytorch.org/whl/rocm7.0 .
ARG ROCM_VERSION=7.0

FROM ghcr.io/astral-sh/uv:0.11.30 AS uv

FROM rocm/dev-ubuntu-22.04:${ROCM_VERSION}

ARG TORCH_INDEX_URL=https://download.pytorch.org/whl/rocm7.0

ENV DEBIAN_FRONTEND=noninteractive \
    CXX=g++ \
    PATH="/opt/venv/bin:$PATH" \
    PYTHONUNBUFFERED=1 \
    UV_LINK_MODE=copy \
    UV_PYTHON_DOWNLOADS=0 \
    VIRTUAL_ENV=/opt/venv \
    KCORAL_GPU_BACKEND=rocm

RUN apt-get update \
    && apt-get install --no-install-recommends -y \
        bubblewrap \
        ca-certificates \
        g++ \
        python3 \
        python3-venv \
    && rm -rf /var/lib/apt/lists/*

COPY --from=uv /uv /uvx /bin/

WORKDIR /workspace/kcoral

# torch from the ROCm index brings its matching pytorch-triton-rocm.
RUN --mount=type=cache,target=/root/.cache/uv \
    uv venv /opt/venv \
    && uv pip install --index-url "$TORCH_INDEX_URL" torch

COPY docker/requirements.rocm.txt /tmp/requirements.rocm.txt
RUN --mount=type=cache,target=/root/.cache/uv \
    uv pip install -r /tmp/requirements.rocm.txt

# --no-deps: the `server` extra would replace the ROCm torch with a CUDA build.
COPY pyproject.toml setup.py MANIFEST.in README.md ./
COPY python ./python
RUN --mount=type=cache,target=/root/.cache/uv \
    SETUPTOOLS_SCM_PRETEND_VERSION=0.0.0+rocm.dev uv pip install --no-deps -e .

ENV KCORAL_SERVER_HOST=0.0.0.0

EXPOSE 8000

CMD ["python", "-m", "kcoral", "server", "--backend", "rocm"]
