# syntax=docker/dockerfile:1

FROM ghcr.io/astral-sh/uv:0.11.30 AS uv

FROM rust:1.87.0-bullseye AS native
WORKDIR /build
COPY Cargo.toml Cargo.lock ./
COPY rust ./rust
RUN cargo build --release --locked --bins

FROM nvidia/cuda:13.2.1-devel-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive \
    CXX=g++ \
    PATH="/opt/venv/bin:$PATH" \
    PYTHONUNBUFFERED=1 \
    UV_LINK_MODE=copy \
    UV_PROJECT_ENVIRONMENT=/opt/venv \
    UV_PYTHON_DOWNLOADS=0

RUN apt-get update \
    && apt-get install --no-install-recommends -y \
        ca-certificates \
        g++ \
        python3 \
    && rm -rf /var/lib/apt/lists/*

COPY --from=uv /uv /uvx /bin/
COPY --from=native /build/target/release/kcoral-node /build/target/release/kcoral-router /usr/local/bin/

WORKDIR /workspace/kcoral

# Install locked third-party dependencies in a layer unaffected by source edits.
COPY pyproject.toml uv.lock README.md ./
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --locked --no-install-project --group gpu --group test

COPY python ./python
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --locked --group gpu --group test

ENV KCORAL_SERVER_HOST=0.0.0.0

EXPOSE 8000

CMD ["python", "-m", "kcoral", "server"]
